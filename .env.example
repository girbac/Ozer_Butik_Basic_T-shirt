# --- Veritabanı ---------------------------------------------------------
# Vercel'de: Storage > Postgres bağlandığında otomatik gelir.
# Yerelde: postgresql://kullanici:sifre@localhost:5432/ozerbutik?schema=public
DATABASE_URL=

# --- Site ---------------------------------------------------------------
# Canlıda kendi alan adınız: https://ozerbutik.com
# iyzico ödeme dönüşü (callback) bu adrese yapılır, mutlaka doğru olmalı.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- iyzico -------------------------------------------------------------
# Anahtarları iyzico panelinden alın. Önce sandbox ile test edin.
# Sandbox: https://sandbox-api.iyzipay.com
# Canlı:   https://api.iyzipay.com
IYZIPAY_API_KEY=
IYZIPAY_SECRET_KEY=
IYZIPAY_URI=https://sandbox-api.iyzipay.com

# --- Görsel yükleme (Vercel Blob) ---------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- E-posta (Resend) ---------------------------------------------------
RESEND_API_KEY=
# Sipariş bildirimlerinin gideceği kendi adresiniz
ORDER_NOTIFICATION_EMAIL=
# Gönderen adresi — Resend'de doğrulanmış alan adınız olmalı
MAIL_FROM="Özer Butik <siparis@ozerbutik.com>"

# --- Admin paneli -------------------------------------------------------
# /admin girişi için tek şifre. Uzun ve tahmin edilemez olsun.
ADMIN_PASSWORD=
# Oturum çerezini imzalamak için rastgele anahtar: openssl rand -base64 32
SESSION_SECRET=
